# Read automatically by `docker compose`.

# Host port for the GUI (7860 is taken by another container on this machine).
GUI_PORT=7861

# Model served by the API. After `docker compose --profile train run --rm train`
# switch to the fine-tuned one: MODEL_ID=/models/vit-beans
MODEL_ID=google/vit-base-patch16-224

# Resources for the GPU containers (inference and train)
GPU_ID=0
INFERENCE_MEMORY=6g
INFERENCE_CPUS=4

# Fine-tuning epochs
EPOCHS=3
